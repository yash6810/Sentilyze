{
  "pythonVersion": "3.10",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["."],
  "include": [
    "src",
    "tests",
    "app.py",
    "train.py",
    "api.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    "d:/__pyrefly_virtual__",
    "**/__pyrefly_virtual__",
    "**/inmemory/**"
  ],
  "reportMissingImports": false
}
